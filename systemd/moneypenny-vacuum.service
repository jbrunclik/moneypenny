# Systemd user service for Moneypenny database vacuum
# Install to: ~/.config/systemd/user/moneypenny-vacuum.service
# This service is triggered by moneypenny-vacuum.timer

[Unit]
Description=Moneypenny - Database vacuum (reclaim space and optimize)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/moneypenny
ExecStart=%h/src/moneypenny/.venv/bin/python scripts/vacuum_databases.py
Environment=PATH=%h/src/moneypenny/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Load environment from .env file (for database paths)
EnvironmentFile=%h/src/moneypenny/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Don't restart on failure (timer will retry next week)
Restart=no

[Install]
WantedBy=default.target
