# Systemd user service for Moneypenny
# Install to: ~/.config/systemd/user/moneypenny.service
# Enable with: systemctl --user enable moneypenny
# Start with: systemctl --user start moneypenny
# View logs: journalctl --user -u moneypenny -f

[Unit]
Description=Moneypenny - Personal Gemini-powered assistant
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/src/moneypenny

# Build frontend before starting (npm install + build)
ExecStartPre=/bin/bash -c 'cd %h/src/moneypenny/web && npm install && npm run build'

# Worker class: gthread (threaded). Long SSE streaming responses (chat/stream)
# must NOT use the default sync worker — sync workers suspend their master
# heartbeat for the whole request, so any stream exceeding --timeout is killed
# mid-response (WORKER TIMEOUT -> SystemExit). gthread keeps heart-beating from
# its main loop while requests run in a thread pool, so long streams complete.
# Concurrency per process = GUNICORN_THREADS; each chat stream uses ~2 threads.
ExecStart=/bin/bash -c 'cd %h/src/moneypenny && .venv/bin/gunicorn --bind 0.0.0.0:${PORT} --workers ${GUNICORN_WORKERS:-2} --worker-class gthread --threads ${GUNICORN_THREADS:-8} --timeout ${GUNICORN_TIMEOUT:-600} --max-requests ${GUNICORN_MAX_REQUESTS:-1000} --max-requests-jitter ${GUNICORN_MAX_REQUESTS_JITTER:-50} --access-logfile - --error-logfile - --log-level info --capture-output "src.app:create_app()"'

# Graceful reload: sends SIGHUP to gunicorn master, which spawns new workers
# and gracefully shuts down old workers after they finish current requests
ExecReload=/bin/kill -s HUP $MAINPID

Restart=on-failure
RestartSec=5
Environment=PATH=%h/src/moneypenny/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Load environment from .env file
EnvironmentFile=%h/src/moneypenny/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Log rotation and limits
# Limit log rate to prevent disk space issues (especially with DEBUG logging)
# LogRateLimitIntervalSec: Time window for rate limiting (default: 30s)
# LogRateLimitBurst: Max messages per interval (default: 10000)
# These settings allow ~333 messages/second, which should be sufficient
# Adjust if you need more verbose logging or want stricter limits
LogRateLimitIntervalSec=30
LogRateLimitBurst=10000

# Maximum log size per service (default: 10% of systemd journal size)
# This limits how much space this service's logs can use
# Set to 0 to disable per-service limit (use global journald limits instead)
# LogsMaxBytes=100M

[Install]
WantedBy=default.target
