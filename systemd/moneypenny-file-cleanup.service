# Systemd user service for Moneypenny file retention cleanup
# Install to: ~/.config/systemd/user/moneypenny-file-cleanup.service
# This service is triggered by moneypenny-file-cleanup.timer

[Unit]
Description=Moneypenny - File retention cleanup (expired attachments)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/moneypenny
ExecStart=%h/src/moneypenny/.venv/bin/python scripts/cleanup_files.py
Environment=PATH=%h/src/moneypenny/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Load environment from .env file (for database paths and retention windows)
EnvironmentFile=%h/src/moneypenny/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Don't restart on failure (timer will retry next day)
Restart=no

[Install]
WantedBy=default.target
