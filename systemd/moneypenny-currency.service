# Systemd user service for Moneypenny currency rate updates
# Install to: ~/.config/systemd/user/moneypenny-currency.service
# This service is triggered by moneypenny-currency.timer

[Unit]
Description=Moneypenny - Update currency exchange rates
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/moneypenny
ExecStart=%h/src/moneypenny/.venv/bin/python scripts/update_currency_rates.py
Environment=PATH=%h/src/moneypenny/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Load environment from .env file (for database paths)
EnvironmentFile=%h/src/moneypenny/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Don't restart on failure (timer will retry tomorrow)
Restart=no

[Install]
WantedBy=default.target
