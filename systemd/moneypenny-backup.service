# Systemd user service for Moneypenny database backup
# Install to: ~/.config/systemd/user/moneypenny-backup.service
# This service is triggered by moneypenny-backup.timer

[Unit]
Description=Moneypenny - Database backup (daily snapshots)
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/moneypenny
ExecStart=%h/src/moneypenny/.venv/bin/python scripts/backup_databases.py
Environment=PATH=%h/src/moneypenny/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Load environment from .env file (for database paths)
EnvironmentFile=%h/src/moneypenny/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Don't restart on failure (timer will retry next day)
Restart=no

[Install]
WantedBy=default.target
