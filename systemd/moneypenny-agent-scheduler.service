# Systemd user service for Moneypenny agent scheduler
# Install to: ~/.config/systemd/user/moneypenny-agent-scheduler.service
# This service is triggered by moneypenny-agent-scheduler.timer

[Unit]
Description=Moneypenny - Autonomous agent scheduler
After=network.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/moneypenny
ExecStart=%h/src/moneypenny/.venv/bin/python scripts/run_agent_scheduler.py
Environment=PATH=%h/src/moneypenny/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Load environment from .env file (for database paths, API keys)
EnvironmentFile=%h/src/moneypenny/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Don't restart on failure (timer will retry next minute)
Restart=no

# Timeout after 5 minutes (agents may take time to execute)
TimeoutStartSec=300

[Install]
WantedBy=default.target
