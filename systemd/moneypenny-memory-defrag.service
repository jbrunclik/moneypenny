# Systemd user service for Moneypenny memory defragmentation
# Install to: ~/.config/systemd/user/moneypenny-memory-defrag.service
# This service is triggered by moneypenny-memory-defrag.timer

[Unit]
Description=Moneypenny - Defragment user memories
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/moneypenny
ExecStart=%h/src/moneypenny/.venv/bin/python scripts/defragment_memories.py
Environment=PATH=%h/src/moneypenny/.venv/bin:/usr/local/bin:/usr/bin:/bin

# Load environment from .env file (for API keys, database paths)
EnvironmentFile=%h/src/moneypenny/.env

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

# Don't restart on failure (timer will retry tomorrow)
Restart=no

# Allow longer runtime for LLM processing (30 minutes max)
TimeoutStartSec=1800

[Install]
WantedBy=default.target
